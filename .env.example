# Copia este fichero a .env.local y rellénalo. .env.local no se sube a git.

# Solo para scripts/analysis: rol de Postgres con permisos SELECT únicamente.
ANALYSIS_DATABASE_URL=postgresql://usuario_lectura:clave@db.xxxx.supabase.co:5432/postgres
# ANALYSIS_SCHEMA=public

# Web: cliente de Supabase con la anon key (RLS de solo lectura).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (sitemap, metadatos). En Vercel: la del dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
