# Servicio de Roodada en el VPS (scripts/vps/remote-setup.sh lo instala en /etc/systemd/system/).
# Corre con su propio usuario, sin permisos sobre las otras webs, con memoria limitada y reinicio automático.
[Unit]
Description=Roodada (Next.js)
After=network.target

[Service]
Type=simple
User=roodada
Group=roodada
WorkingDirectory=/srv/roodada/app
EnvironmentFile=/srv/roodada/.env
ExecStart=__NODE__ server.js
Restart=always
RestartSec=3
# Memoria (27-11-2026, tras dos cierres por falta de memoria con 1500M): las fotos (sharp/libvips) fragmentan la
# memoria de glibc y crece sin parar. MALLOC_ARENA_MAX la contiene, VIPS_CONCURRENCY limita los hilos de fotos y
# max-old-space-size hace que Node limpie antes. MemoryHigh frena el proceso antes de llegar al tope y que lo cierren.
Environment=MALLOC_ARENA_MAX=2
Environment=VIPS_CONCURRENCY=2
Environment=NODE_OPTIONS=--max-old-space-size=768
MemoryHigh=2000M
MemoryMax=2500M
# Aislamiento: no puede escribir fuera de /srv/roodada
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/roodada
PrivateTmp=true

[Install]
WantedBy=multi-user.target
